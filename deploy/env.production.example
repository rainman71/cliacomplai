# Rightsize CLIA Compliance — production .env template
# Copy to .env on the server and fill the CHANGE_ME values. Never commit the real .env.
#
# Two phases (see deploy/RUNBOOK.md):
#   Phase A (now): bring up on the server IP to validate the deploy.
#   Phase B (later): point a domain + SSL, turn on Google SSO + SMTP.

APP_NAME="Rightsize CLIA Compliance"
APP_ENV=production
APP_KEY=                       # run: php artisan key:generate
APP_DEBUG=false                # NEVER true in production
APP_URL=http://CHANGE_ME_SERVER_IP

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (MySQL is already set up on your server) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rightsize
DB_USERNAME=rightsize
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync          # mail sent synchronously; no queue worker needed
CACHE_STORE=database

# --- Mail: log driver during IP staging; switch to Workspace SMTP at the domain cutover ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="compliance@CHANGE_ME_domain"
MAIL_FROM_NAME="Rightsize CLIA Compliance"

# --- Google SSO ---
# Leave BLANK during IP staging: Google will not redirect OAuth to a bare IP over http.
# Interactive login on the IP requires the dev-login fallback (APP_ENV=local) — see RUNBOOK Phase A.
# Fill these at the domain cutover (Phase B) and add the redirect URI in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
AUTH_ALLOWED_DOMAIN=           # e.g. yourdomain.com — locks logins to your Workspace

# --- Google Drive auto-filing ---
# scp the service-account JSON to a path OUTSIDE the web root, then point to it here.
# The root folder id below is the existing Shared Drive root (not secret; access needs the key).
GOOGLE_DRIVE_CREDENTIALS=/var/www/secrets/drive-sa.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=18fXxFA4yjdER1_aIC6Yc2-_c17ZsU1jO
